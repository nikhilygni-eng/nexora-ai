# Copy to .env.local and fill in. Never commit .env.local.

# --- PayPal (Sandbox only) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# sandbox = real PayPal Sandbox API. mock = in-process fake for local dev/E2E (rows are labeled "Mock PayPal").
PAYPAL_MODE=sandbox
# Optional (P2): webhook ID from your Sandbox app → enables /api/webhooks/paypal with signature verification
PAYPAL_WEBHOOK_ID=

# --- AI ---
# freellmapi (default) = local FreeLLMAPI router (OpenAI-compatible). gemini = Google Gemini via @google/genai.
AI_PROVIDER=freellmapi
FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_API_KEY=
# "auto", "auto:smart", "auto:fast" or a specific model id served by your router
FREELLMAPI_MODEL=auto:smart
GEMINI_API_KEY=
# Gemini model: gemini-3.5-flash (best) or gemini-3.5-flash-lite (faster, separate free-tier quota)
AI_MODEL=
AI_TIMEOUT_MS=45000
# Gemini 3.x thinking depth: minimal | low | medium | high (lower = faster)
AI_THINKING_LEVEL=low

# --- AI traffic gate (protects the provider quota under load; see README → Reliability) ---
# Max model calls per minute across all users. 0 = off. Free-tier gemini-3.5-flash-lite: use 14.
AI_MAX_RPM=0
# Simultaneous model calls, callers allowed to wait, and the longest wait before "busy, try again".
AI_MAX_CONCURRENCY=4
AI_QUEUE_MAX=50
AI_QUEUE_WAIT_MS=20000
# Reuse AI insights for identical figures for this many seconds ("Regenerate" always asks again).
INSIGHTS_CACHE_SEC=600

# --- App ---
# At least 6 characters. Used to sign in.
APP_PASSCODE=
DATABASE_PATH=./data/nexora.db
# true = re-add the labeled demo invoices at startup if they're missing (useful on hosts that wipe disk)
DEMO_AUTOSEED=
